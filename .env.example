HOST=127.0.0.1
PORT=3000
NODE_ENV=development

DB_SOCKET=/run/mysqld/mysqld.sock
# Use DB_HOST=127.0.0.1 and DB_PORT=3306 instead when MariaDB runs in a container.
DB_NAME=waypoint
DB_USER=waypoint_app
DB_PASSWORD=replace-with-runtime-password
DB_CONNECTION_LIMIT=5

ADZUNA_APP_ID=replace-with-adzuna-app-id
ADZUNA_APP_KEY=replace-with-adzuna-app-key

# OpenStreetMap Nominatim requires a real contact identity in the User-Agent.
# Replace the contact address below; location resolution stays disabled while it is blank.
GEOCODER_BASE_URL=https://nominatim.openstreetmap.org
GEOCODER_USER_AGENT=Waypoint/0.1 (contact: replace-with-email@example.com)

# Provider request budgets: caps on how many Adzuna pages one operation may request.
DISCOVERY_RUN_REQUEST_BUDGET=20
DISCOVERY_QUERY_REQUEST_BUDGET=12
DISCOVERY_PREVIEW_REQUEST_BUDGET=8
DISCOVERY_MAX_PAGES_PER_FAMILY=3
DISCOVERY_PERSISTED_MATCH_TARGET=50

# Optional in-app assistant (OpenAI-compatible chat completions API).
# Leave ASSISTANT_BASE_URL and ASSISTANT_MODEL blank to disable the coach UI.
# Examples:
#   Ollama:      ASSISTANT_BASE_URL=http://127.0.0.1:11434/v1   ASSISTANT_MODEL=llama3.2
#   LM Studio:   ASSISTANT_BASE_URL=http://127.0.0.1:1234/v1    ASSISTANT_MODEL=local-model
#   Hosted API:  ASSISTANT_BASE_URL=https://api.openai.com/v1  ASSISTANT_MODEL=gpt-4o-mini  ASSISTANT_API_KEY=sk-...
ASSISTANT_BASE_URL=
ASSISTANT_MODEL=
ASSISTANT_API_KEY=
# ASSISTANT_TIMEOUT_MS=60000
# ASSISTANT_MAX_TOOL_ITERATIONS=6

# Used only by `npm run db:migrate`; keep these out of the runtime service environment.
MIGRATION_DB_USER=waypoint_migrate
MIGRATION_DB_PASSWORD=replace-with-migration-password
