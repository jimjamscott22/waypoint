[Unit]
Description=Waypoint scheduled Adzuna ingestion
After=network-online.target mariadb.service
Wants=network-online.target

[Service]
Type=oneshot
User=waypoint
Group=waypoint
WorkingDirectory=/opt/waypoint/current
EnvironmentFile=/etc/waypoint/waypoint.env
ExecStart=/usr/bin/node server/cli/scrape.js
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/opt/waypoint/current /etc/waypoint
